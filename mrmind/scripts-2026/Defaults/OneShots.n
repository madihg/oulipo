//This topic has 20 randomly non-repeating topics; 
//5 of them test for variables (whether user has stated UserNeed, UserWant, UserHave, UserCan, UserCan't) 

Default topic "Is that your RealName" is
Subjects "Names";
	IfChance 0.90
	Then 
		Say "By the way, is " + ?Name + " <BR>your real name or a special <BR>one just for me?";
		Suppress This;
	Done
EndTopic
	
Default topic "HowDidYouFindMe" is 
//refers to topic: Defaults\Answers.n\HowFindMe
	IfChance 0.70 
	Then
		SayOneOf "How did you find me?", "Who told you about me?", "How did you find my site?";
		Suppress This;
	Done
Endtopic	


Default topic "AnsToWhereDoYouLive" is 
//refers to topic: Defaults\Answers.n\WhereDoYouLive
	IfChance 0.50 
	Then
		Say "By the way, <BR>where do you live?";
		Suppress This;
	Done
Endtopic		
	
Default topic "WhyTalktoHuman" is 
//refers to topic: Defaults\Answers.n\WhyTalk
	IfChance 0.20 
	Then
		Say "If you are a human, why are you <BR>talking, I mean typing, to a <BR>machine? Why don't you go talk <BR>to a human?";
		Suppress This;
	Done
Endtopic

